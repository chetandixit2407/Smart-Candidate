PORT=3000
GEMINI_API_KEY=

# Optional server-side API secret (if set, clients must pass x-api-key or Authorization: Bearer <secret>)
HR_API_SECRET=
PUBLIC_APP_URL=
DEFAULT_PHONE_COUNTRY_CODE=+91

# ----------------------------------------------------------------------------
# Real Email API Credentials (Configure Option A: SMTP OR Option B: Resend)
# ----------------------------------------------------------------------------
# Option A: SMTP (e.g. Gmail App Password, Microsoft 365, Amazon SES, SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Option B: Resend HTTP API (https://resend.com)
RESEND_API_KEY=

# ----------------------------------------------------------------------------
# Real WhatsApp API Credentials (Configure Option A: Meta Cloud OR Option B: Twilio)
# ----------------------------------------------------------------------------
# Option A: Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Option B: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ----------------------------------------------------------------------------
# Scheduled Automation Jobs Configuration (node-cron)
# ----------------------------------------------------------------------------
ASSET_REMINDER_CRON=0 * * * *
ASSET_REMINDER_RETRY_CRON=*/5 * * * *
NOTIFICATION_MAX_RETRIES=3
